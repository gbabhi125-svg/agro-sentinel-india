# Weather — Open-Meteo needs no key, listed for clarity only
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Market prices — required for real Agmarknet mandi prices
# Get from https://data.gov.in -> My Account -> API Keys
DATA_GOV_IN_API_KEY=

# Proactive alerts (Phase 5+) — https://console.firebase.google.com
FIREBASE_SERVER_KEY=

# WhatsApp / SMS share + escalation (Phase 6+) — https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
