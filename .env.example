# Login sessions — any long random string. Changing it logs everyone out.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Weather — Open-Meteo needs no key, listed for clarity only
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Market prices — real Agmarknet mandi prices
# Get from https://data.gov.in -> My Account -> API Keys
DATA_GOV_IN_API_KEY=

# Proactive push alerts — Firebase Cloud Messaging HTTP v1 API
# https://console.firebase.google.com -> Project settings -> Service accounts -> Generate new private key
# Put the downloaded JSON file somewhere NOT committed to git and point to it here.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Crop Doctor "connect to an expert" escalation — Meta WhatsApp Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Chosen over Twilio: official, no platform markup, free for this app's volume.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
ESCALATION_WHATSAPP_TO=

# Optional SMS fallback for farmers without a smartphone — textbee.dev
# Needs a spare Android phone running the TextBee app on a normal SIM plan.
# https://textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
